{
  "name": "yunidesk-react-native",
  "version": "0.6.0",
  "private": false,
  "description": "Native Yunidesk support messenger for React Native and Expo apps.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "react-native": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
