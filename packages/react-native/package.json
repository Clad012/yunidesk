  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "expo-document-picker": "56.0.4",
    "expo-image-picker": "56.0.17",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-safe-area-context": "5.10.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
