{
  "name": "yunidesk",
  "version": "0.6.0",
  "private": false,
  "type": "module",
  "description": "Yunidesk client SDK core: types, the contact client (REST + realtime), identity tokens and webhook signatures for self-hosted Yunidesk support desks.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./identity": "./src/identity.ts",
    "./webhooks": "./src/webhooks.ts",
    "./api": "./src/api.ts"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsup src/index.ts src/client.ts src/identity.ts src/webhooks.ts src/api.ts --format esm,cjs --dts --clean --target es2022",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "tsup": "8.5.1"
  },
  "keywords": [
    "support",
    "live-chat",
    "helpdesk",
    "intercom-alternative",
    "cloudflare-workers",
    "self-hosted"
  ],
  "license": "MIT",
  "author": "Achraf Chaibi",
  "homepage": "https://github.com/Clad012/yunidesk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Clad012/yunidesk.git",
    "directory": "packages/protocol"
  },
  "bugs": {
    "url": "https://github.com/Clad012/yunidesk/issues"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      },
      "./client": {
        "types": "./dist/client.d.ts",
        "import": "./dist/client.js",
        "require": "./dist/client.cjs"
      },
      "./identity": {
        "types": "./dist/identity.d.ts",
        "import": "./dist/identity.js",
        "require": "./dist/identity.cjs"
      },
      "./webhooks": {
        "types": "./dist/webhooks.d.ts",
        "import": "./dist/webhooks.js",
        "require": "./dist/webhooks.cjs"
      },
      "./package.json": "./package.json",
      "./api": {
        "types": "./dist/api.d.ts",
        "import": "./dist/api.js",
        "require": "./dist/api.cjs"
      }
    }
  }
}
