{
  "name": "yunidesk-react",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "description": "Embed the Yunidesk support messenger in a React or Next.js web app.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "build": "tsup",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "react": "19.3.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "tsup": "8.5.1"
  },
  "keywords": [
    "support",
    "live-chat",
    "react",
    "nextjs",
    "messenger",
    "yunidesk"
  ],
  "license": "MIT",
  "author": "Achraf Chaibi",
  "homepage": "https://github.com/Clad012/yunidesk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Clad012/yunidesk.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/Clad012/yunidesk/issues"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      },
      "./package.json": "./package.json"
    }
  }
}
